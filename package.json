{
  "name": "osone-ai-multiuser-stable",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "vercel-build": "vite build",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "test:load": "node --test --experimental-strip-types tests/multiuser-load.test.ts",
    "test:smoke": "node tests/production-smoke.mjs",
    "check": "npm run lint && npm test && npm run build && npm run build:vercel",
    "build:vercel": "esbuild api/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/vercel-function.cjs"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "docx": "^9.6.1",
    "dotenv": "^17.2.3",
    "express": "^4.22.2",
    "file-saver": "^2.0.5",
    "framer-motion": "^11.18.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.5.0",
    "three": "^0.185.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/d3-geo": "^3.1.0",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.14.0",
    "@types/three": "^0.185.1",
    "@types/topojson-client": "^3.1.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "0.28.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.1",
    "typescript": "~5.8.2",
    "vite": "^7.3.6"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@protobufjs/utf8": "1.1.2",
    "dompurify": "3.4.12",
    "esbuild": "0.28.1",
    "postcss": "8.5.23",
    "protobufjs": "7.6.5",
    "ws": "8.21.1"
  }
}
